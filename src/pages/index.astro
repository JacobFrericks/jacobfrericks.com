---
import Base from "../layouts/Base.astro";
import TopBar from "../components/TopBar.astro";
import Hero from "../components/Hero.astro";
import Chain from "../components/Chain.astro";
import Slsa from "../components/Slsa.astro";
import Projects from "../components/Projects.astro";
import Career from "../components/Career.astro";
import Toolbox from "../components/Toolbox.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

const links = [
  { label: "The chain", href: "#chain" },
  { label: "Projects", href: "#projects" },
  { label: "Verify", href: "#verify" },
  { label: "Career", href: "#career" },
  { label: "Contact", href: "#contact" },
  { label: "GitHub", href: "https://github.com/JacobFrericks" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/jacobfrericks" },
];
---

<Base
  title="Jacob Frericks | Staff DevOps Engineer"
  description="Staff DevOps Engineer focused on software supply chain security."
>
  <TopBar links={links} />
  <Hero />
  <Chain />
  <Slsa />
  <Projects />
  <Career />
  <Toolbox />
  <Contact />
  <Footer />
</Base>
