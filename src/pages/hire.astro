---
import Base from "../layouts/Base.astro";
import TopBar from "../components/TopBar.astro";
import pkg from "../../package.json";
import { career } from "../data/career";
import { highlights, location, skills } from "../data/hire";

const years = new Date().getFullYear() - 2013;
const when = (start: number, end: number | "now") => (start === end ? `${start}` : `${start} – ${end}`);
---

<Base
  title="Jacob Frericks | Hire"
  description="Staff DevOps Engineer in Des Moines, open to remote. CI/CD platforms, signed builds, and software supply chain security."
  theme="whiteprint"
>
  <TopBar links={[{ label: "Full site, for engineers →", href: "/" }]} />

  <div class="head">
    <div>
      <div class="label">Staff DevOps Engineer · DevSecOps · Software supply chain</div>
      <h1>Jacob Frericks</h1>
      <p class="where">{location.city} · <b>{location.remote}</b></p>
      <p class="lead">
        I build secure pipelines developers actually use. My focus is CI/CD platforms, signed builds, and guardrails
        for the software supply chain.
      </p>
      <div class="actions">
        <a class="btn solid" href="https://www.linkedin.com/in/jacobfrericks">LinkedIn</a>
        <a class="btn" href="/jacob-frericks-resume.pdf" download>Résumé (PDF)</a>
        <a class="btn" href="https://github.com/JacobFrericks">GitHub</a>
      </div>
    </div>
    <div class="titleblock" aria-label="Drawing title block">
      <div class="wide"><b>Drawing</b>Hire sheet</div>
      <div><b>Dwg no.</b>JF-002</div>
      <div><b>Rev</b>{pkg.version}</div>
      <div><b>Sheet</b>1 of 1</div>
      <div><b>Since</b>2013</div>
    </div>
  </div>

  <div class="facts">
    <div class="fact"><span class="big">{years} years</span><p>Building and running software delivery since 2013.</p></div>
    <div class="fact">
      <span class="big">Tech lead</span><p>GitHub &amp; GitHub Actions platform at a Fortune 10 healthcare company.</p>
    </div>
    <div class="fact"><span class="big">SLSA L3</span><p>Building it at work. This site already ships at it.</p></div>
  </div>

  <div class="body">
    <div class="col">
      <section id="highlights">
        <h2>Highlights</h2>
        <ul class="highlights">
          {
            highlights.map((item) => (
              <li>
                {item.text}
                <small>{item.when}</small>
              </li>
            ))
          }
        </ul>
      </section>
      <section id="skills">
        <h2>Skills</h2>
        <div class="skills">
          {
            skills.map((group) => (
              <div class="skill-row">
                <span class="label">{group.label}</span>
                <ul class="tools">
                  {group.tools.map((tool) => (
                    <li class="chip">{tool}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>
    </div>
    <div class="col">
      <section id="experience">
        <h2>Experience</h2>
        <table class="exp">
          <tbody>
            {
              career.map((role) => (
                <tr>
                  <td>{when(role.start, role.end)}</td>
                  <td>
                    <b>{role.title}</b>
                    <span>{role.org}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>
    </div>
  </div>

  <footer class="foot">
    <span>This page is signed with SLSA Build L3 provenance · v{pkg.version}</span>
    <a href="/#verify">Verify it →</a>
  </footer>
</Base>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 250px;
    gap: 28px;
    padding: 28px 24px 24px;
    border-bottom: 1px solid var(--line-mid);
  }
  h1 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(40px, 6vw, 60px);
    line-height: 0.95;
    text-transform: uppercase;
    margin: 8px 0 6px;
    letter-spacing: 0.01em;
  }
  .where {
    font-family: var(--mono);
    font-size: 13px;
    margin: 0 0 12px;
  }
  .where b {
    color: var(--ok);
    font-weight: 600;
  }
  .lead {
    font-size: 18px;
    color: var(--muted);
    margin: 0 0 18px;
    max-width: 52ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .titleblock {
    align-self: start;
    border: 1px solid var(--line-mid);
    font-family: var(--mono);
    font-size: 11.5px;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .titleblock div {
    padding: 7px 10px;
    border-bottom: 1px solid var(--line-mid);
    border-right: 1px solid var(--line-mid);
  }
  .titleblock div:nth-child(2n) {
    border-right: 0;
  }
  .titleblock .wide {
    grid-column: 1 / -1;
    border-right: 0;
  }
  .titleblock div:last-child,
  .titleblock div:nth-last-child(2) {
    border-bottom: 0;
  }
  .titleblock b {
    display: block;
    font-weight: 400;
    color: var(--muted);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--line-mid);
  }
  .fact {
    padding: 18px 24px;
    border-right: 1px solid var(--line-mid);
    display: grid;
    gap: 2px;
    align-content: start;
  }
  .fact:last-child {
    border-right: 0;
  }
  .big {
    font-family: var(--display);
    font-weight: 700;
    font-size: 34px;
    line-height: 1;
    text-transform: uppercase;
  }
  .fact p {
    margin: 0;
    color: var(--muted);
    font-size: 13.5px;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
  }
  .col {
    padding: 20px 24px;
    display: grid;
    gap: 20px;
    align-content: start;
  }
  .col + .col {
    border-left: 1px solid var(--line-mid);
  }
  h2 {
    font-family: var(--display);
    font-weight: 700;
    font-size: 22px;
    text-transform: uppercase;
    margin: 0 0 10px;
    letter-spacing: 0.02em;
  }
  .highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .highlights li {
    position: relative;
    padding-left: 24px;
  }
  .highlights li::before {
    content: "✓";
    position: absolute;
    left: 2px;
    color: var(--ok);
    font-weight: 600;
  }
  .highlights small {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }
  .skills {
    display: grid;
    gap: 10px;
  }
  .skill-row {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 10px;
    align-items: baseline;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tools .chip {
    font-size: 12px;
    padding: 3px 8px;
    background: var(--ground);
  }
  .exp {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .exp td {
    padding: 7px 0;
    border-bottom: 1px solid var(--line-mid);
    vertical-align: top;
  }
  .exp tr:last-child td {
    border-bottom: 0;
  }
  .exp td:first-child {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    width: 98px;
    font-variant-numeric: tabular-nums;
    padding-top: 9px;
  }
  .exp b {
    display: block;
    font-weight: 600;
  }
  .exp span {
    color: var(--muted);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    justify-content: space-between;
    padding: 12px 24px;
    border-top: 1px solid var(--line-mid);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 820px) {
    .head {
      grid-template-columns: 1fr;
    }
    .titleblock {
      max-width: 320px;
    }
    .body {
      grid-template-columns: 1fr;
    }
    .col + .col {
      border-left: 0;
      border-top: 1px solid var(--line-mid);
    }
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: 1fr;
    }
    .fact {
      border-right: 0;
      border-bottom: 1px solid var(--line-mid);
    }
    .fact:last-child {
      border-bottom: 0;
    }
    .skill-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
