---
import { links, defaultLink } from "../data/chain";

const number = (i: number) => String(i + 1).padStart(2, "0");
---

<section id="chain">
  <div class="sec-head">
    <span class="label">Section A</span>
    <h2>The chain</h2>
    <p>
      Six links between a developer's keyboard and production. Pick a link to see the risk, a real attack on it,
      and the work I have done to protect it.
    </p>
  </div>

  <div class="chain" role="tablist" aria-label="Supply chain links">
    {
      links.map((link, i) => (
        <button
          class="link"
          type="button"
          role="tab"
          id={`tab-${link.id}`}
          aria-controls={`panel-${link.id}`}
          aria-selected={link.id === defaultLink ? "true" : "false"}
          tabindex={link.id === defaultLink ? 0 : -1}
        >
          <span class="node">
            <span>{number(i)}</span>
          </span>
          <span class="link-name">{link.name}</span>
          <span class={link.inProgress ? "link-state wip" : "link-state"}>
            {link.inProgress ? "◐ L3 in progress" : "● secured"}
          </span>
        </button>
      ))
    }
  </div>

  {
    links.map((link, i) => (
      <div
        class="panel"
        role="tabpanel"
        id={`panel-${link.id}`}
        aria-labelledby={`tab-${link.id}`}
        hidden={link.id !== defaultLink}
      >
        <div>
          <span class="label">Link {number(i)} · Risk</span>
          <h3>{link.name}</h3>
          <p>{link.risk}</p>
        </div>
        <div class="attack">
          <span class="label">Real attack</span>
          <h3>{link.attack}</h3>
          <p>{link.attackText}</p>
        </div>
        <div class="control">
          <span class="label">My work</span>
          <h3>Controls</h3>
          <ul>
            {link.controls.map((control) => (
              <li>
                {control.what}
                <small>{control.where}</small>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))
  }
</section>

<script>
  // Tab behavior: click or use the arrow keys to switch links. Panels are already in the HTML.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("#chain [role=tab]")];

  function select(tab: HTMLButtonElement) {
    for (const other of tabs) {
      const selected = other === tab;
      other.setAttribute("aria-selected", String(selected));
      other.tabIndex = selected ? 0 : -1;
      document.getElementById(other.getAttribute("aria-controls")!)!.hidden = !selected;
    }
    tab.focus();
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(tab));
    tab.addEventListener("keydown", (event) => {
      const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
      if (step) select(tabs[(i + step + tabs.length) % tabs.length]);
    });
  });
</script>

<style>
  section {
    padding: 48px 24px;
    border-top: 1px solid var(--line-mid);
  }
  .sec-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 20px;
    margin-bottom: 28px;
  }
  h2 {
    font-family: var(--display);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 36px;
    line-height: 1;
    margin: 0;
    letter-spacing: 0.02em;
  }
  .sec-head p {
    margin: 0;
    color: var(--muted);
    max-width: 62ch;
    flex-basis: 100%;
  }
  .chain {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    position: relative;
    margin-bottom: 24px;
  }
  .chain::before {
    content: "";
    position: absolute;
    left: 8%;
    right: 8%;
    top: 37px;
    border-top: 1px dashed var(--line-mid);
  }
  .link {
    position: relative;
    background: none;
    border: 0;
    color: var(--paper);
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 0 4px 8px;
    cursor: pointer;
    font: inherit;
  }
  .node {
    width: 74px;
    height: 74px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    background: var(--ground);
    font-family: var(--mono);
    font-size: 13px;
    color: var(--line);
    transform: rotate(45deg);
    transition: background 0.15s, color 0.15s;
  }
  .node span {
    transform: rotate(-45deg);
  }
  .link-name {
    font-family: var(--display);
    font-size: 20px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .link-state {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ok);
  }
  .link-state.wip {
    color: var(--risk);
  }
  .link:hover .node {
    background: var(--line-faint);
  }
  .link[aria-selected="true"] .node {
    background: var(--line);
    color: var(--ground-deep);
  }
  .link[aria-selected="true"] .link-name {
    color: var(--line);
  }
  .panel {
    border: 1px solid var(--line-mid);
    background: rgba(10, 32, 56, 0.7);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .panel[hidden] {
    display: none;
  }
  .panel > div {
    padding: 22px;
    border-right: 1px solid var(--line-faint);
    display: grid;
    align-content: start;
    gap: 8px;
  }
  .panel > div:last-child {
    border-right: 0;
  }
  h3 {
    margin: 0;
    font-family: var(--display);
    font-size: 24px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .panel p {
    margin: 0;
    color: var(--muted);
  }
  .attack h3 {
    color: var(--risk);
  }
  .control h3 {
    color: var(--ok);
  }
  ul {
    margin: 0;
    padding-left: 18px;
  }
  li {
    margin-bottom: 6px;
  }
  li small {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .panel {
      grid-template-columns: 1fr;
    }
    .panel > div {
      border-right: 0;
      border-bottom: 1px solid var(--line-faint);
    }
  }
  @media (max-width: 640px) {
    .chain {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 24px;
    }
    .chain::before {
      display: none;
    }
    .node {
      width: 56px;
      height: 56px;
      font-size: 11px;
    }
  }
</style>
