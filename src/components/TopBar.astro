---
interface Props {
  links: { label: string; href: string }[];
}

const { links } = Astro.props;
---

<header class="topbar">
  <a class="mark" href="/">Jacob<span>.</span>Frericks</a>
  <nav aria-label="Main">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</header>

<style>
  .topbar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
    border-bottom: 1px solid var(--line-mid);
  }
  .mark {
    font-family: var(--display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--paper);
    text-decoration: none;
  }
  .mark span {
    color: var(--line);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    align-items: center;
  }
  nav a {
    color: var(--paper);
    text-decoration: none;
    font-size: 14px;
  }
  nav a:hover {
    color: var(--line);
  }
</style>
