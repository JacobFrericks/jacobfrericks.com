---
import pkg from "../../package.json";

const repo = "https://github.com/JacobFrericks/jacobfrericks.com";
---

<footer>
  <span>© Jacob Frericks · DWG JF-001 rev {pkg.version}</span>
  <nav aria-label="Footer">
    <a href={repo}>Source</a>
    <a href={`${repo}/releases/latest`}>Release v{pkg.version}</a>
    <a href={`${repo}/blob/main/LICENSE`}>MIT license (code)</a>
  </nav>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    justify-content: space-between;
    align-items: center;
    padding: 18px 24px;
    border-top: 1px solid var(--line-mid);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }
</style>
