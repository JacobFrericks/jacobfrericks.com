---
const repo = "https://github.com/JacobFrericks/jacobfrericks.com";

// Links only, no form: nothing to spam, and the CSP keeps form-action 'none'.
const links = [
  { label: "LinkedIn", note: "The best way to reach me about roles", href: "https://www.linkedin.com/in/jacobfrericks" },
  { label: "GitHub", note: "Code, this site's source, and issues", href: "https://github.com/JacobFrericks" },
  { label: "Report a security issue", note: "Private, through GitHub", href: `${repo}/security/advisories/new` },
];
---

<section id="contact" class="section">
  <div class="sec-head">
    <span class="label">Section F</span>
    <h2>Contact</h2>
    <p>Questions about a pipeline, SLSA, or something on this page? Reach out here.</p>
  </div>

  <ul class="contact">
    {
      links.map((link) => (
        <li>
          <a href={link.href}>
            <span class="name">{link.label} →</span>
            <span class="note">{link.note}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  a {
    display: grid;
    gap: 6px;
    padding: 20px;
    border: 1px solid var(--line-mid);
    text-decoration: none;
    height: 100%;
  }
  a:hover {
    border-color: var(--line);
    background: var(--line-faint);
  }
  .name {
    font-family: var(--display);
    font-size: 24px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--line);
  }
  .note {
    color: var(--muted);
    font-size: 14px;
  }
  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
