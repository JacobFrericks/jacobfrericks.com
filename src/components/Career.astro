---
import { career } from "../data/career";

const when = (start: number, end: number | "now") => (start === end ? `${start}` : `${start} – ${end}`);
---

<section id="career" class="section">
  <div class="sec-head">
    <span class="label">Section D</span>
    <h2>Career</h2>
    <p>Developer first, then the pipelines, then securing them.</p>
  </div>

  <ol class="timeline" reversed>
    {
      career.map((role) => (
        <li class={role.end === "now" ? "now" : role.kind === "education" ? "education" : undefined}>
          <span class="when">{when(role.start, role.end)}</span>
          <div>
            <h3>
              {role.title} <span>· {role.org}</span>
            </h3>
            {role.summary && <p>{role.summary}</p>}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0 0 0 6px;
    padding: 0;
    display: grid;
    border-left: 1px solid var(--line-mid);
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 4px 24px;
    padding: 0 0 26px 26px;
  }
  li:last-child {
    padding-bottom: 0;
  }
  li::before {
    content: "";
    position: absolute;
    left: -6px;
    top: 6px;
    width: 11px;
    height: 11px;
    background: var(--ground);
    border: 1px solid var(--line);
    transform: rotate(45deg);
  }
  li.now::before {
    background: var(--line);
  }
  li.education::before {
    border-color: var(--muted);
    width: 7px;
    height: 7px;
    left: -4px;
    top: 8px;
  }
  .when {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    padding-top: 2px;
    font-variant-numeric: tabular-nums;
  }
  h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
  }
  h3 span {
    color: var(--muted);
    font-weight: 400;
  }
  p {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 14px;
    max-width: 64ch;
  }
  @media (max-width: 640px) {
    li {
      grid-template-columns: 1fr;
    }
  }
</style>
