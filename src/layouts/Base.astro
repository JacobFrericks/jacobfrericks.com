---
// Fonts are bundled from npm so the site makes no third-party requests.
import "@fontsource/barlow-condensed/latin-600.css";
import "@fontsource/barlow-condensed/latin-700.css";
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-600.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  // "whiteprint" is the light version used on the recruiter page.
  theme?: "blueprint" | "whiteprint";
  // Print-only pages skip the drawing frame and ask search engines not to index them.
  printOnly?: boolean;
}

const { title, description, theme = "blueprint", printOnly = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* Only this site's own files may load. GitHub Pages cannot set headers, so the policy lives here. */}
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {printOnly && <meta name="robots" content="noindex" />}
  </head>
  <body data-theme={theme}>
    {
      printOnly ? (
        <slot />
      ) : (
        <div class="sheet">
          <div class="frame">
            <slot />
          </div>
        </div>
      )
    }
  </body>
</html>
